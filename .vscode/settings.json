{
    "window.title": "vue-storefront-store-budsies${separator}${activeEditorShort} ${dirty}",
    "vue.server.path": "node_modules/@vue/language-server",
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "emmet.includeLanguages": {
        "vue": "html"
    },
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "cSpell.words": [
        "Approvements",
        "BODYPARTS",
        "BUDSIE",
        "Budsies",
        "HUGGABLES",
        "PETSIE",
        "Paginator",
        "Plushie",
        "Plushies",
        "WAGGABLES",
        "ascendancyy",
        "autosize",
        "blueimp",
        "concat",
        "counterparties",
        "datetime",
        "exif",
        "fieldset",
        "filepond",
        "heic",
        "heif",
        "jquery",
        "keyup",
        "minmax",
        "mixins",
        "multiline",
        "nowrap",
        "preload",
        "readonly",
        "stylelint",
        "tbody",
        "thead",
        "uploader",
        "uuidv",
        "vnodes",
        "vuejs",
        "vuex",
        "websanova",
        "xlarge",
        "xxlarge",
        "zurb"
    ],
    "githubIssues.issueBranchTitle": "${issueNumber}-${sanitizedIssueTitle}",
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "file": ".github/copilot-commit-message-instructions.md"
        }
    ],
    "chat.detectParticipant.enabled": false,
    "chat.checkpoints.showFileChanges": true,
    "chat.tools.terminal.autoApprove": {
        "/usr/bin/openspec": true,
        "openspec": true
    }
}
