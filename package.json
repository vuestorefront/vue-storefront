{
  "name": "vue-storefront",
  "version": "1.12.2",
  "description": "A Vue.js, PWA eCommerce frontend",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "24.17.0",
    "yarn": "4.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuestorefront/vue-storefront"
  },
  "keywords": [
    "vue",
    "vuex",
    "vue-router",
    "webpack",
    "starter",
    "server-side",
    "boilerplate"
  ],
  "author": "pkarw <pkarwatka@divante.pl> and contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vuestorefront/vue-storefront/issues"
  },
  "homepage": "https://github.com/vuestorefront/vue-storefront/README.md",
  "scripts": {
    "static-server": "cross-env TS_NODE_PROJECT=\"tsconfig-build.json\" ts-node ./core/scripts/static-server.ts",
    "generate": "cross-env TS_NODE_PROJECT=\"tsconfig-build.json\" ts-node ./core/scripts/generate.ts",
    "generate-files": "cross-env NODE_OPTIONS=--no-deprecation TS_NODE_PROJECT=\"tsconfig-build.json\" ts-node ./core/scripts/generate-files.ts",
    "start": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"tsconfig-build.json\" pm2-runtime start ecosystem.json",
    "start:inspect": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"tsconfig-build.json\" node --inspect=0.0.0.0 -r ts-node/register ./core/scripts/server",
    "all": "cross-env NODE_ENV=development node ./core/scripts/all",
    "cache": "node ./core/scripts/cache",
    "dev": "yarn generate-files && yarn dev:server",
    "dev:server": "cross-env NODE_OPTIONS=--no-deprecation TS_NODE_PROJECT=\"tsconfig-build.json\" node --max_old_space_size=3072 -r ts-node/register ./core/scripts/server.ts",
    "dev:sw": "yarn generate-files && cross-env TS_NODE_PROJECT=\"tsconfig-build.json\" yarn build:sw && yarn dev",
    "dev:inspect": "yarn generate-files && cross-env NODE_OPTIONS=--no-deprecation TS_NODE_PROJECT=\"tsconfig-build.json\" node --inspect=0.0.0.0 -r ts-node/register ./core/scripts/server",
    "build:sw": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production TS_NODE_PROJECT=\"tsconfig-build.json\" webpack --config ./core/build/webpack.prod.sw.config.ts && node --no-deprecation ./core/build/generate-service-worker.js",
    "build:client": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production TS_NODE_PROJECT=\"tsconfig-build.json\" webpack --config ./core/build/webpack.prod.client.config.ts",
    "build:server": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production TS_NODE_PROJECT=\"tsconfig-build.json\" webpack --config ./core/build/webpack.prod.server.config.ts",
    "build:bundles": "npm-run-all -p build:client build:server",
    "build": "rimraf dist && yarn generate-files && yarn build:bundles && yarn build:sw",
    "test:unit": "jest -c test/unit/jest.conf.js",
    "test:unit:maintained": "jest -c test/unit/jest.conf.js --testPathIgnorePatterns='/(core|e2e-tests)/'",
    "test:unit:core": "jest -c test/unit/jest.conf.js --testPathPattern=/core/",
    "test:unit:watch": "jest -c test/unit/jest.conf.js --watch",
    "test:e2e": "cypress open",
    "test:e2e:ci": "cypress run",
    "test:upgrade:config": "node test/upgrade/configuration-lifecycle.js",
    "test:upgrade:type-check-watch": "node test/upgrade/vue-tsc-watch-coordinator.js",
    "type-check": "vue-tsc --noEmit -p tsconfig.vue-tsc.json",
    "type-check:watch": "vue-tsc --noEmit --watch --pretty --preserveWatchOutput -p tsconfig.vue-tsc.json",
    "lint": "cross-env NODE_ENV=production eslint \"core/**/*.{js,ts,vue}\" \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "yarn lint --fix",
    "deduplicate-lock": "yarn dedupe",
    "update-i18n-files": "node core/i18n/scripts/updateI18nFiles.js src/themes/petsies-capybara/resource/i18n/en-US.csv"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
